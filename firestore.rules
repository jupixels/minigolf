rules_version = '2';

// Security rules for Tiny Tees Community maps.
// Paste this into Firebase console → Firestore Database → Rules, then click Publish.
//
// What it allows:
//   • Anyone can read and play public maps.
//   • Signed-in players (anonymous sign-in) can publish maps under their own id.
//   • Only the publisher can update or delete their map.
//   • Anyone can add exactly +1 play, and +1 like once per player.
//   • Hole records: each player keeps one score per hole, which can only improve.
//     Republishing a map bumps its version, which starts fresh records.
service cloud.firestore {
  match /databases/{database}/documents {

    function validMap(d) {
      return d.keys().hasAll(['name', 'author', 'uid', 'data', 'holes', 'likes', 'plays', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'nameLower', 'emoji', 'author', 'uid', 'data', 'holes', 'theme',
                             'likes', 'plays', 'version', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.author is string && d.author.size() <= 24
        && d.data is string && d.data.size() < 200000
        && d.holes is int && d.holes >= 1 && d.holes <= 9
        && d.likes is int && d.plays is int;
    }

    match /maps/{mapId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && validMap(request.resource.data)
        && request.resource.data.likes == 0
        && request.resource.data.plays == 0
        && request.resource.data.get('version', 0) == 0
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null && (
        // The publisher edits their own map (counters and ownership can't change).
        (resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.likes == resource.data.likes
          && request.resource.data.plays == resource.data.plays
          && request.resource.data.get('version', 0) == resource.data.get('version', 0) + 1
          && validMap(request.resource.data))
        ||
        // Anyone: one more play.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays'])
          && request.resource.data.plays == resource.data.plays + 1)
        ||
        // Anyone: one more like, only together with creating their own like marker.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes == resource.data.likes + 1
          && !exists(/databases/$(database)/documents/maps/$(mapId)/likes/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/maps/$(mapId)/likes/$(request.auth.uid)))
      );

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      match /likes/{userId} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == userId;
      }

      // Hole records. Document id: "<version>_<hole>_<uid>".
      match /scores/{scoreId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'name', 'hole', 'strokes', 'version', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.hole is int && request.resource.data.version is int
          && scoreId == string(request.resource.data.version) + '_' + string(request.resource.data.hole) + '_' + request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
          && request.resource.data.hole >= 0
          && request.resource.data.hole < get(/databases/$(database)/documents/maps/$(mapId)).data.holes
          && request.resource.data.version == get(/databases/$(database)/documents/maps/$(mapId)).data.get('version', 0)
          && request.resource.data.strokes is int
          && request.resource.data.strokes >= 1 && request.resource.data.strokes <= 10
          && request.resource.data.at == request.time
          && (resource == null || request.resource.data.strokes < resource.data.strokes);
      }
    }
  }
}
